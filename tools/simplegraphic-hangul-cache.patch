+// SimpleGraphic Engine
+// Unicode glyphs rasterized into a runtime bitmap atlas from the bundled Korean font.
+
+#pragma once
+
+#include <memory>
+
+class r_renderer_c;
+class r_tex_c;
+
+struct r_unicode_glyph_s {
+	r_tex_c* tex = nullptr;
+	float tcLeft = 0.0f;
+	float tcRight = 0.0f;
+	float tcTop = 0.0f;
+	float tcBottom = 0.0f;
+	int width = 0;
+	int height = 0;
+	int spLeft = 0;
+	int spRight = 0;
+	int yOffset = 0;
+};
+
+class r_unicode_font_cache_c {
+public:
+	explicit r_unicode_font_cache_c(r_renderer_c* renderer);
+	~r_unicode_font_cache_c();
+
+	bool GetGlyph(char32_t codepoint, int height, bool bold, r_unicode_glyph_s& glyph);
+	void BeginFrame();
+
+private:
+	struct impl;
+	std::unique_ptr<impl> data;
+};
