diff --git a/engine/render/r_unicode_font.cpp b/engine/render/r_unicode_font.cpp
new file mode 100644
index 0000000..2db48ff
--- /dev/null
+++ b/engine/render/r_unicode_font.cpp
@@ -0,0 +1,346 @@
+// SimpleGraphic Engine
+// Runtime bitmap atlas for Unicode glyphs missing from the PoB ASCII atlases.
+
+#include "r_local.h"
+#include "r_unicode_font.h"
+
+#ifdef _WIN32
+#include <windows.h>
+#include <algorithm>
+#include <cstdint>
+#include <fstream>
+#include <iterator>
+#include <unordered_map>
+#include <vector>
+
+namespace {
+constexpr int atlasSize = 1024;
+constexpr size_t maxAtlasBytes = 64 * 1024 * 1024;
+constexpr int atlasBytes = atlasSize * atlasSize * 4;
+
+bool IsKoreanCodepoint(char32_t cp)
+{
+	return (cp >= 0x1100 && cp <= 0x11FF)
+		|| (cp >= 0x3130 && cp <= 0x318F)
+		|| (cp >= 0xA960 && cp <= 0xA97F)
+		|| (cp >= 0xAC00 && cp <= 0xD7A3)
+		|| (cp >= 0xD7B0 && cp <= 0xD7FF)
+		|| (cp >= 0x2000 && cp <= 0x206F)
+		|| (cp >= 0x3000 && cp <= 0x303F)
+		|| (cp >= 0xFF00 && cp <= 0xFFEF)
+		|| cp == 0x20A9;
+}
+
+uint64_t MakeKey(char32_t cp, int height, bool bold)
+{
+	return ((uint64_t)cp << 16) | ((uint64_t)height << 1) | (bold ? 1 : 0);
+}
+}
+
+struct r_unicode_font_cache_c::impl {
+	explicit impl(r_renderer_c* renderer)
+		: renderer(renderer)
+	{
+		std::ifstream font(CFG_DATAPATH "Fonts/NotoSansKR-Regular.ttf", std::ios::binary);
+		if (!font) {
+			renderer->sys->con->Warning("Korean bitmap font not found");
+			return;
+		}
+		fontData.assign(std::istreambuf_iterator<char>(font), std::istreambuf_iterator<char>());
+		if (fontData.empty() || fontData.size() > UINT32_MAX) {
+			renderer->sys->con->Warning("Korean bitmap font is empty or too large");
+			fontData.clear();
+			return;
+		}
+		DWORD fontCount = 0;
+		fontResource = AddFontMemResourceEx(fontData.data(), (DWORD)fontData.size(), nullptr, &fontCount);
+		if (!fontResource || fontCount == 0) {
+			renderer->sys->con->Warning("Could not load bundled Korean bitmap font");
+			fontResource = nullptr;
+			fontData.clear();
+		}
+	}
+
+	~impl()
+	{
+		for (auto& context : contexts) {
+			SelectObject(context.second.dc, context.second.previousFont);
+			DeleteObject(context.second.font);
+			DeleteDC(context.second.dc);
+		}
+		pages.clear();
+		if (fontResource) {
+			RemoveFontMemResourceEx(fontResource);
+		}
+	}
+
+	struct font_context_s {
+		HDC dc = nullptr;
+		HFONT font = nullptr;
+		HGDIOBJ previousFont = nullptr;
+		TEXTMETRICW metrics{};
+	};
+
+	struct atlas_page_s {
+		std::unique_ptr<r_tex_c> texture;
+		int x = 1;
+		int y = 1;
+		int rowHeight = 0;
+		uint64_t lastUsedFrame = 0;
+		std::vector<uint64_t> keys;
+	};
+
+	struct cached_glyph_s {
+		r_unicode_glyph_s glyph;
+		size_t pageIndex = 0;
+	};
+
+	struct glyph_bitmap_s {
+		std::vector<byte> rgba;
+		int width = 0;
+		int height = 0;
+		int spLeft = 0;
+		int spRight = 0;
+		int yOffset = 0;
+		int advance = 0;
+	};
+
+	font_context_s* GetFontContext(int height, bool bold)
+	{
+		const uint64_t key = ((uint64_t)height << 1) | (bold ? 1 : 0);
+		auto found = contexts.find(key);
+		if (found != contexts.end()) {
+			return &found->second;
+		}
+
+		font_context_s context;
+		context.dc = CreateCompatibleDC(nullptr);
+		if (!context.dc) return nullptr;
+		context.font = CreateFontW(-height, 0, 0, 0, bold ? FW_BOLD : FW_NORMAL, FALSE, FALSE, FALSE,
+			DEFAULT_CHARSET, OUT_TT_PRECIS, CLIP_DEFAULT_PRECIS, CLEARTYPE_QUALITY,
+			DEFAULT_PITCH | FF_DONTCARE, L"Noto Sans KR");
+		if (!context.font) {
+			DeleteDC(context.dc);
+			return nullptr;
+		}
+		context.previousFont = SelectObject(context.dc, context.font);
+		if (!context.previousFont || context.previousFont == HGDI_ERROR || !GetTextMetricsW(context.dc, &context.metrics)) {
+			if (context.previousFont && context.previousFont != HGDI_ERROR) SelectObject(context.dc, context.previousFont);
+			DeleteObject(context.font);
+			DeleteDC(context.dc);
+			return nullptr;
+		}
+		return &contexts.emplace(key, context).first->second;
+	}
+
+	bool Rasterize(char32_t cp, int height, bool bold, glyph_bitmap_s& result)
+	{
+		auto* context = GetFontContext(height, bold);
+		if (!context) return false;
+		WCHAR character = (WCHAR)cp;
+		WORD glyphIndex = 0xFFFF;
+		if (GetGlyphIndicesW(context->dc, &character, 1, &glyphIndex, GGI_MARK_NONEXISTING_GLYPHS) == GDI_ERROR || glyphIndex == 0xFFFF) return false;
+		const MAT2 identity = { 0, 1, 0, 0, 0, 0, 0, 1 };
+		GLYPHMETRICS metrics{};
+		const DWORD format = GGO_GRAY8_BITMAP | GGO_GLYPH_INDEX;
+		const DWORD size = GetGlyphOutlineW(context->dc, glyphIndex, format, &metrics, 0, nullptr, &identity);
+		if (size == GDI_ERROR) return false;
+
+		result.width = (int)metrics.gmBlackBoxX;
+		result.height = (int)metrics.gmBlackBoxY;
+		result.spLeft = metrics.gmptGlyphOrigin.x;
+		result.advance = metrics.gmCellIncX;
+		result.spRight = result.advance - result.spLeft - result.width;
+		result.yOffset = context->metrics.tmAscent - metrics.gmptGlyphOrigin.y;
+		if (result.width <= 0 || result.height <= 0 || size == 0) {
+			result.width = 0;
+			result.height = 0;
+			return true;
+		}
+
+		std::vector<byte> gray(size);
+		if (GetGlyphOutlineW(context->dc, glyphIndex, format, &metrics, size, gray.data(), &identity) == GDI_ERROR) return false;
+		const int grayStride = (int)(size / result.height);
+		const int sourceHeight = result.height;
+		result.height = (std::min)(result.height, height);
+		result.yOffset = (std::clamp)(result.yOffset, 0, height - result.height);
+		result.rgba.resize((size_t)result.width * result.height * 4);
+		for (int y = 0; y < result.height; ++y) {
+			const int sourceY = (int)((int64_t)y * sourceHeight / result.height);
+			for (int x = 0; x < result.width; ++x) {
+				const size_t dst = ((size_t)y * result.width + x) * 4;
+				const byte coverage = (std::min)(gray[(size_t)sourceY * grayStride + x], (byte)64);
+				const byte alpha = (byte)((unsigned)coverage * 255 / 64);
+				result.rgba[dst] = 255;
+				result.rgba[dst + 1] = 255;
+				result.rgba[dst + 2] = 255;
+				result.rgba[dst + 3] = alpha;
+			}
+		}
+		return true;
+	}
+
+	bool CreatePage(atlas_page_s& page)
+	{
+		std::vector<byte> blank(atlasBytes, 255);
+		for (size_t alpha = 3; alpha < blank.size(); alpha += 4) blank[alpha] = 0;
+		auto image = std::make_unique<image_c>();
+		if (!image->CopyRaw(IMGTYPE_RGBA, atlasSize, atlasSize, blank.data())) return false;
+		page.texture = std::make_unique<r_tex_c>(renderer->texMan, std::move(image), TF_NOMIPMAP | TF_CLAMP);
+		return page.texture && page.texture->status == r_tex_c::DONE;
+	}
+
+	bool ResetPage(size_t index)
+	{
+		auto& page = pages[index];
+		for (uint64_t key : page.keys) glyphs.erase(key);
+		page.keys.clear();
+		std::vector<byte> blank(atlasBytes, 255);
+		for (size_t alpha = 3; alpha < blank.size(); alpha += 4) blank[alpha] = 0;
+		if (!page.texture->UpdateSubImage(0, 0, atlasSize, atlasSize, blank.data())) return false;
+		page.x = page.y = 1;
+		page.rowHeight = 0;
+		page.lastUsedFrame = frame;
+		return true;
+	}
+
+	bool Place(int width, int height, size_t& pageIndex, int& x, int& y)
+	{
+		const int cellWidth = width + 2;
+		const int cellHeight = height + 2;
+		if (cellWidth > atlasSize || cellHeight > atlasSize) return false;
+		auto fits = [=](atlas_page_s const& page) {
+			int rowX = page.x;
+			int rowY = page.y;
+			if (rowX + cellWidth > atlasSize) {
+				rowX = 1;
+				rowY += page.rowHeight;
+			}
+			return rowY + cellHeight <= atlasSize;
+		};
+		for (size_t i = 0; i < pages.size(); ++i) {
+			if (fits(pages[i])) {
+				pageIndex = i;
+				auto& page = pages[i];
+				if (page.x + cellWidth > atlasSize) {
+					page.x = 1;
+					page.y += page.rowHeight;
+					page.rowHeight = 0;
+				}
+				x = page.x + 1;
+				y = page.y + 1;
+				page.x += cellWidth;
+				page.rowHeight = (std::max)(page.rowHeight, cellHeight);
+				return true;
+			}
+		}
+
+		if (pages.size() * (size_t)atlasBytes < maxAtlasBytes) {
+			atlas_page_s page;
+			if (!CreatePage(page)) return false;
+			pages.push_back(std::move(page));
+			pageIndex = pages.size() - 1;
+			auto& created = pages.back();
+			x = created.x + 1;
+			y = created.y + 1;
+			created.x += cellWidth;
+			created.rowHeight = cellHeight;
+			return true;
+		}
+
+		size_t oldest = pages.size();
+		for (size_t i = 0; i < pages.size(); ++i) {
+			if (pages[i].lastUsedFrame < frame && (oldest == pages.size() || pages[i].lastUsedFrame < pages[oldest].lastUsedFrame)) {
+				oldest = i;
+			}
+		}
+		if (oldest == pages.size() || !ResetPage(oldest)) return false;
+		pageIndex = oldest;
+		auto& page = pages[oldest];
+		x = page.x + 1;
+		y = page.y + 1;
+		page.x += cellWidth;
+		page.rowHeight = cellHeight;
+		return true;
+	}
+
+	bool GetGlyph(char32_t cp, int height, bool bold, r_unicode_glyph_s& output)
+	{
+		if (!fontResource || !IsKoreanCodepoint(cp) || height <= 0 || height > 256) return false;
+		const uint64_t key = MakeKey(cp, height, bold);
+		auto found = glyphs.find(key);
+		if (found != glyphs.end()) {
+			pages[found->second.pageIndex].lastUsedFrame = frame;
+			output = found->second.glyph;
+			return true;
+		}
+
+		glyph_bitmap_s bitmap;
+		if (!Rasterize(cp, height, bold, bitmap)) return false;
+		if (bitmap.width == 0) {
+			output = {};
+			output.width = 0;
+			output.spLeft = bitmap.spLeft;
+			output.spRight = bitmap.spRight;
+			output.yOffset = bitmap.yOffset;
+			return true;
+		}
+
+		size_t pageIndex;
+		int x, y;
+		if (!Place(bitmap.width, bitmap.height, pageIndex, x, y)) return false;
+		auto& page = pages[pageIndex];
+		if (!page.texture->UpdateSubImage(x, y, bitmap.width, bitmap.height, bitmap.rgba.data())) return false;
+		page.lastUsedFrame = frame;
+		r_unicode_glyph_s glyph;
+		glyph.tex = page.texture.get();
+		glyph.tcLeft = (float)x / atlasSize;
+		glyph.tcRight = (float)(x + bitmap.width) / atlasSize;
+		glyph.tcTop = (float)y / atlasSize;
+		glyph.tcBottom = (float)(y + bitmap.height) / atlasSize;
+		glyph.width = bitmap.width;
+		glyph.height = bitmap.height;
+		glyph.spLeft = bitmap.spLeft;
+		glyph.spRight = bitmap.spRight;
+		glyph.yOffset = bitmap.yOffset;
+		page.keys.push_back(key);
+		glyphs.emplace(key, cached_glyph_s{ glyph, pageIndex });
+		output = glyph;
+		return true;
+	}
+
+	r_renderer_c* renderer;
+	std::vector<char> fontData;
+	HANDLE fontResource = nullptr;
+	std::unordered_map<uint64_t, font_context_s> contexts;
+	std::vector<atlas_page_s> pages;
+	std::unordered_map<uint64_t, cached_glyph_s> glyphs;
+	uint64_t frame = 1;
+};
+
+r_unicode_font_cache_c::r_unicode_font_cache_c(r_renderer_c* renderer)
+	: data(std::make_unique<impl>(renderer))
+{}
+
+r_unicode_font_cache_c::~r_unicode_font_cache_c() = default;
+
+bool r_unicode_font_cache_c::GetGlyph(char32_t codepoint, int height, bool bold, r_unicode_glyph_s& glyph)
+{
+	return data->GetGlyph(codepoint, height, bold, glyph);
+}
+
+void r_unicode_font_cache_c::BeginFrame()
+{
+	++data->frame;
+}
+
+#else
+
+struct r_unicode_font_cache_c::impl {};
+
+r_unicode_font_cache_c::r_unicode_font_cache_c(r_renderer_c*) : data(std::make_unique<impl>()) {}
+r_unicode_font_cache_c::~r_unicode_font_cache_c() = default;
+bool r_unicode_font_cache_c::GetGlyph(char32_t, int, bool, r_unicode_glyph_s&) { return false; }
+void r_unicode_font_cache_c::BeginFrame() {}
+
+#endif
