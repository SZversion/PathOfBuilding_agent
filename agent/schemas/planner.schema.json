{
  "type": "object",
  "required": [
    "schema_version",
    "intent",
    "operation",
    "evidenceLevel",
    "required_evidence",
    "stop_condition",
    "ambiguities",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "intent": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "evidenceLevel": {
      "type": "string"
    },
    "required_evidence": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "stop_condition": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["answer", "ask_user"]
        }
      },
      "additionalProperties": false
    },
    "ambiguities": {
      "type": "array",
      "description": "JSON Pointer paths to ambiguous fields in this plan JSON, never game component names or instruction names. Use [] when no field needs clarification.",
      "minItems": 0,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^/(intent|operation|evidenceLevel|required_evidence/(0|[1-9][0-9]*)|stop_condition/[A-Za-z_][A-Za-z0-9_]*|steps/(0|[1-9][0-9]*)/(tool|expectedSnapshotRevision|arguments/[A-Za-z_][A-Za-z0-9_]*(/[A-Za-z0-9_]+)*))$"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tool",
          "arguments"
        ],
        "properties": {
          "tool": {
            "type": "string"
          },
          "arguments": {
            "type": "object"
          },
          "expectedSnapshotRevision": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "stop_condition"
        ],
        "properties": {
          "stop_condition": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "ask_user"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "ambiguities"
        ],
        "properties": {
          "ambiguities": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
