FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY requirements-mcp.txt requirements-container.txt ./
RUN python -m pip install --upgrade pip && python -m pip install -r requirements-container.txt
COPY agent ./agent

EXPOSE 8080 8000
CMD ["uvicorn", "agent.http_backend:app", "--host", "0.0.0.0", "--port", "8080"]
