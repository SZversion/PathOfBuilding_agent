# Copy to .env.docker and replace all CHANGE_ME values before starting Docker.
# Generate secrets with: py -c "import secrets; print(secrets.token_hex(32))"

POB_AGENT_API_TOKEN=CHANGE_ME_RANDOM_API_TOKEN
POB_AGENT_MCP_TOKEN=CHANGE_ME_DIFFERENT_RANDOM_MCP_TOKEN

# Host paths. Keep the PoB endpoint directory read-only in the containers.
POB_ENDPOINT_HOST_PATH=C:/Users/SZ/Documents/Path of Building
POB_BUILDS_HOST_PATH=./builds

# Model endpoint must be reachable from Docker. For a service on Windows host, use host.docker.internal.
POB_AGENT_MODEL_ENDPOINT=http://host.docker.internal:11434/v1
POB_AGENT_MODEL_PROVIDER=ollama
POB_AGENT_MODEL=qwen3:8b
POB_AGENT_API_KEY=

# Langfuse SDK credentials. These values also initialize the local Langfuse project.
LANGFUSE_PUBLIC_KEY=pk-lf-CHANGE_ME_RANDOM_VALUE
LANGFUSE_SECRET_KEY=sk-lf-CHANGE_ME_RANDOM_VALUE
LANGFUSE_INIT_USER_EMAIL=admin@example.local
LANGFUSE_INIT_USER_PASSWORD=CHANGE_ME_LANGFUSE_ADMIN_PASSWORD
LANGFUSE_INIT_USER_NAME=PoB Agent Admin
LANGFUSE_INIT_ORG_ID=pob-agent
LANGFUSE_INIT_ORG_NAME=PoB Agent
LANGFUSE_INIT_PROJECT_ID=pob-agent
LANGFUSE_INIT_PROJECT_NAME=PoB Agent
POB_AGENT_LANGFUSE_SAMPLE_RATE=1

# Langfuse self-host infrastructure secrets. Use independent random values.
LANGFUSE_SALT=CHANGE_ME_LANGFUSE_SALT
LANGFUSE_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARACTERS
LANGFUSE_NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
CLICKHOUSE_PASSWORD=CHANGE_ME_CLICKHOUSE_PASSWORD
REDIS_AUTH=CHANGE_ME_REDIS_PASSWORD
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD

# Optional host ports.
BACKEND_PORT=8080
LANGFUSE_PORT=3000
MINIO_PORT=9090
MINIO_CONSOLE_PORT=9091
